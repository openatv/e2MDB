#!/bin/sh
### BEGIN INIT INFO
# Provides:          e2mdbd
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     3 4 5
# Default-Stop:      0 1 2 6
# Short-Description: e2MDB backend daemon
### END INIT INFO

DAEMON_NAME="e2mdbd"
DAEMON_DIR="/usr/lib/enigma2/python/Plugins/Extensions/e2MDB"
DAEMON_SCRIPT="$DAEMON_DIR/e2mdbd.pyc"
PIDFILE="/var/run/e2mdbd.pid"
LOGFILE="/home/root/logs/e2mdbd.log"
PYTHON="${PYTHON:-/usr/bin/python3}"

[ -x "$PYTHON" ] || PYTHON="/usr/bin/python"

start_daemon() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "$DAEMON_NAME already running"
		return 0
	fi
	mkdir -p /var/run/e2mdb /etc/enigma2/e2mdb /home/root/logs
	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -m -p "$PIDFILE" -x "$PYTHON" -O "$LOGFILE" -- "$DAEMON_SCRIPT"
	else
		"$PYTHON" "$DAEMON_SCRIPT" >> "$LOGFILE" 2>&1 &
		echo $! > "$PIDFILE"
	fi
	# Under memory pressure the kernel OOM-killer picks the largest process not
	# explicitly protected. enigma2 runs at oom_score_adj=-999, so e2mdbd (the
	# next-largest resident process) becomes the default victim even when the
	# actual memory hog is something else. -300 makes it a less obvious target
	# without hiding it from the OOM-killer entirely.
	if [ -f "$PIDFILE" ]; then
		echo -300 > "/proc/$(cat "$PIDFILE")/oom_score_adj" 2>/dev/null
	fi
	echo "Started $DAEMON_NAME"
}

stop_daemon() {
	if [ ! -f "$PIDFILE" ]; then
		echo "$DAEMON_NAME not running"
		return 0
	fi
	PID="$(cat "$PIDFILE")"
	if kill -0 "$PID" 2>/dev/null; then
		kill "$PID" 2>/dev/null
		COUNT=0
		while kill -0 "$PID" 2>/dev/null && [ "$COUNT" -lt 10 ]; do
			sleep 1
			COUNT=$((COUNT + 1))
		done
		if kill -0 "$PID" 2>/dev/null; then
			kill -9 "$PID" 2>/dev/null
		fi
	fi
	rm -f "$PIDFILE" /var/run/e2mdb/e2mdbd.sock
	echo "Stopped $DAEMON_NAME"
}

case "$1" in
	start)
		start_daemon
		;;
	stop)
		stop_daemon
		;;
	restart)
		stop_daemon
		start_daemon
		;;
	status)
		if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			echo "$DAEMON_NAME is running"
			exit 0
		fi
		echo "$DAEMON_NAME is not running"
		exit 3
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac

exit 0
